# Accept the Community-1 model conditions on Hugging Face first.
HF_TOKEN=
FISH_TTS_URL=http://127.0.0.1:8080/v1/tts
FISH_API_KEY=
# Absolute path to the Python executable in a separate Demucs environment.
DEMUCS_PYTHON=/absolute/path/to/demucs-venv/bin/python
ANIMODE_DEVICE=cpu
ASR_MODEL=large-v3

# Studio settings
FISH_MODEL_ID=s2-pro
# Change FISH_MODEL_ID whenever your server checkpoint/version changes (cache key).
ANIMODE_OUTPUT_ROOT=outputs
GRADIO_ANALYTICS_ENABLED=False
# Required only for the API. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANIMODE_API_TOKEN=
ANIMODE_API_ROOT=api_data
# Docker needs a Fish server reachable from the container, not host-loopback-only.
FISH_CONTAINER_TTS_URL=http://host.docker.internal:8080/v1/tts
